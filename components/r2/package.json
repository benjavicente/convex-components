{
  "name": "@benjavicente/convex-r2",
  "version": "0.0.1",
  "description": "Cloudflare R2 uploads for Convex: server-owned keys, bound presigned URLs and typed confirmation callbacks.",
  "keywords": [
    "cloudflare",
    "convex",
    "convex-component",
    "r2",
    "upload"
  ],
  "homepage": "https://github.com/benjavicente/convex-components/tree/main/components/r2#readme",
  "bugs": "https://github.com/benjavicente/convex-components/issues",
  "license": "MIT",
  "author": "Benjamín Vicente",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjavicente/convex-components.git",
    "directory": "components/r2"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./test": "./src/test.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vp test",
    "test:r2": "vp test run src/r2.live.test.ts"
  },
  "devDependencies": {
    "@edge-runtime/vm": "catalog:",
    "@smithy/hash-node": "catalog:",
    "@smithy/protocol-http": "catalog:",
    "@smithy/signature-v4": "catalog:",
    "@types/node": "catalog:",
    "convex": "catalog:",
    "convex-test": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "convex": "^1.50.0"
  }
}
